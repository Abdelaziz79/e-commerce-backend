            {
              "name": "Add Address",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    var addresses = jsonData.data.addresses;",
                      "    if (addresses && addresses.length > 0) {",
                      "        pm.collectionVariables.set(\"addressId\", addresses[addresses.length - 1]._id);",
                      "    }",
                      "}"
