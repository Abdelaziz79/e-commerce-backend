        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test.user@example.com\",\n    \"password\": \"Password123\",\n    \"phone\": \"1234567890\"\n}",
              "options": {
